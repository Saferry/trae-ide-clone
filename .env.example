# Server-side environment variable examples.
# Copy to .env and fill in your values; never commit .env.

# Server
TRAE_PORT=8080
TRAE_PUBLIC_PORT=8443
TRAE_LOG_LEVEL=INFO

# Auth
TRAE_API_KEY=please-change-me-to-a-strong-key

# Model providers (use the ones you actually have keys for)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=